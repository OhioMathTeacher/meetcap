#!/usr/bin/env python3
"""meetcap - record a meeting's audio for later transcription.

Records two independent streams so nothing is lost if one fails:

  <name>-mic.flac     your microphone
  <name>-remote.flac  what the other people said (one app, or the whole system mix)

Two separate ffmpeg processes, on purpose: if one dies mid-meeting the other
keeps going. Keeping the streams apart also means the transcript can tell you
apart from everyone else without any diarization model.

Only stdlib + pactl + ffmpeg. Nothing to install, nothing to import.
"""

import argparse
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

NULL_SINK = "meetcap_capture"
NULL_MONITOR = f"{NULL_SINK}.monitor"
DEFAULT_OUTDIR = Path.home() / "Recordings" / "meetings"


# ---------------------------------------------------------------- pactl glue

def pactl(*args, check=True):
    """Run pactl and return stdout, or None if it failed."""
    try:
        r = subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        if check:
            die(f"pactl failed ({e}). Is PipeWire/PulseAudio running?")
        return None
    if r.returncode != 0:
        if check:
            die(f"pactl {' '.join(args)} failed:\n{r.stderr.strip()}")
        return None
    return r.stdout


def die(msg):
    print(f"meetcap: {msg}", file=sys.stderr)
    sys.exit(1)


def parse_blocks(text, head_re):
    """Parse `pactl list <thing>` output into [{'index':..., props...}]."""
    blocks, cur = [], None
    for line in (text or "").splitlines():
        m = head_re.match(line)
        if m:
            if cur:
                blocks.append(cur)
            cur = {"index": m.group(1)}
            continue
        if cur is None:
            continue
        m = re.match(r'\s+([a-zA-Z0-9_.-]+)\s*=\s*"(.*)"\s*$', line)
        if m:
            cur[m.group(1)] = m.group(2)
            continue
        m = re.match(r"\s+(Sink|Source|Driver|Mute):\s*(.+?)\s*$", line)
        if m:
            cur[m.group(1).lower()] = m.group(2)
    if cur:
        blocks.append(cur)
    return blocks


def sink_inputs():
    return parse_blocks(pactl("list", "sink-inputs"),
                        re.compile(r"^Sink Input #(\d+)"))


def describe_input(si):
    name = si.get("application.name") or "(unnamed)"
    binary = si.get("application.process.binary") or "?"
    media = si.get("media.name") or ""
    return name, binary, media


def sink_of_app(match):
    """Which sink is this app actually playing to? (name, description) or None.

    Zoom does not have to be on your default output. Recording the default
    sink's monitor when the meeting is playing somewhere else captures a
    perfectly valid file containing none of the meeting.
    """
    match = match.lower()
    for si in sink_inputs():
        binary = (si.get("application.process.binary") or "").lower()
        name = (si.get("application.name") or "").lower()
        if match not in binary and match not in name:
            continue
        idx = si.get("sink", "")
        resolved = idx if not idx.isdigit() else _sink_name_for_index(idx)
        if resolved:
            return resolved
    return None


def _sink_name_for_index(index):
    out = pactl("list", "short", "sinks") or ""
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[0] == index:
            return parts[1]
    return None


# "AT2020USB-X Mono" and "NexiGo N660P FHD Webcam Analog Stereo" carry a
# channel-profile suffix that is identical across half the list and tells you
# nothing about which device it is.
_PROFILE_SUFFIX = re.compile(
    r"\s+(?:Analog\s+|Digital\s+)?(?:Stereo|Mono|Surround[\s\d.]*)"
    r"(?:\s*\([^)]*\))?$", re.I)


def pretty_device(description, limit=42):
    """A device name a person can read, shortened to fit a menu."""
    name = _PROFILE_SUFFIX.sub("", (description or "").strip()).strip()
    if not name:
        name = (description or "").strip()
    if len(name) > limit:
        name = name[: limit - 1].rstrip() + "\u2026"
    return name


def device_descriptions(kind="sources"):
    """{device name: human description} for all sinks or sources, in one call.

    One pactl invocation instead of one per device - the office machine lists
    eleven outputs, and eleven subprocesses is a visible pause on startup.
    """
    text = pactl("list", kind, check=False) or ""
    out, current = {}, None
    for line in text.splitlines():
        m = re.match(r"\s+Name:\s*(\S+)", line)
        if m:
            current = m.group(1)
            continue
        m = re.match(r"\s+Description:\s*(.+?)\s*$", line)
        if m and current:
            out.setdefault(current, m.group(1))
    return out


def source_description(name):
    """Human-readable name of a capture device, falling back to its id."""
    for blk in parse_blocks(pactl("list", "sources", check=False),
                            re.compile(r"^Source #(\d+)")):
        if blk.get("node.name") == name or blk.get("device.description"):
            if blk.get("node.name") == name:
                return blk.get("device.description") or name
    # Some servers do not expose node.name; fall back to matching on Name:.
    text = pactl("list", "sources", check=False) or ""
    current, desc = None, None
    for line in text.splitlines():
        m = re.match(r"\s+Name:\s*(\S+)", line)
        if m:
            current, desc = m.group(1), None
            continue
        m = re.match(r"\s+Description:\s*(.+?)\s*$", line)
        if m and current == name:
            return m.group(1)
    return name


def sink_state(name):
    """(muted, volume_percent) for a sink, or (None, None) if unknown."""
    text = pactl("list", "sinks", check=False) or ""
    current, muted, vol = None, None, None
    for line in text.splitlines():
        m = re.match(r"^Sink #(\d+)", line)
        if m:
            if current == name:
                break
            current, muted, vol = None, None, None
            continue
        m = re.match(r'\s+Name:\s*(\S+)', line)
        if m:
            current = m.group(1)
            continue
        if re.match(r"\s+Mute:", line):
            muted = line.strip().endswith("yes")
        m = re.search(r"(\d+)%", line) if line.strip().startswith("Volume:") else None
        if m and vol is None:
            vol = int(m.group(1))
    return (muted, vol) if current == name else (None, None)


def warn_if_output_is_silent(sink):
    """A monitor tap sits after the volume control.

    Muting the speakers does not just stop you hearing the meeting - it records
    digital silence from everyone else, and a low volume records a quiet track
    that transcribes badly. Neither is visible while it is happening.
    """
    muted, vol = sink_state(sink)
    if muted:
        print()
        print("  " + "!" * 62)
        print("  !!  YOUR OUTPUT IS MUTED - THE OTHER SIDE WILL RECORD AS SILENCE")
        print("  " + "!" * 62)
        print(f"  {sink_description(sink)} is muted. This capture reads the audio")
        print("  being sent to that device, so a mute records nothing at all.")
        print("  Unmute it now - the recording is already running.\n")
        return False
    if vol is not None and vol < 40:
        print(f"\n  NOTE: {sink_description(sink)} is at {vol}% volume. The "
              f"recording is\n        taken after the volume control, so the "
              f"other side will be quiet.\n")
        return False
    return True


def sink_description(name):
    """Human-readable name of a sink, so 'where will I hear this' is answerable."""
    for blk in parse_blocks(pactl("list", "sinks"), re.compile(r"^Sink #(\d+)")):
        if blk.get("device.description") and blk.get("node.name") == name:
            return f"{blk['device.description']}"
    out = pactl("list", "short", "sinks") or ""
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[1] == name:
            return name
    return name


def default_sink():
    out = pactl("get-default-sink")
    return (out or "").strip() or None


def real_sources():
    """Input sources that are actual capture devices, not monitors."""
    out = pactl("list", "short", "sources") or ""
    srcs = []
    for line in out.strip().splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and not parts[1].endswith(".monitor"):
            srcs.append(parts[1])
    return srcs


def pick_mic(requested):
    """Resolve the microphone, refusing to silently record a monitor as 'mic'."""
    if requested:
        return requested
    default = (pactl("get-default-source") or "").strip()
    if default and not default.endswith(".monitor"):
        return default
    # The default source is a monitor (common when a Bluetooth headset is the
    # default sink). Recording that as "mic" would duplicate the remote audio
    # and lose your own voice entirely, so pick a real input instead.
    candidates = real_sources()
    if not candidates:
        die("No real microphone source found (default source is a monitor).\n"
            "       Plug in a mic, then check with:  meetcap mics")
    print(f"note: default source '{default}' is a monitor, not a mic.\n"
          f"      Using '{candidates[0]}' instead. Override with --mic.")
    return candidates[0]


# ------------------------------------------------------- per-app routing

class AppRoute:
    """Null sink + loopback + a watcher that keeps the app's audio corralled.

    The app's streams get moved into a private null sink, which is looped back
    to the real output so you still hear the meeting. Recording reads the null
    sink's monitor, so it contains that app and nothing else.
    """

    def __init__(self, match, monitor_sink=None):
        self.match = match.lower()
        self.monitor_sink = monitor_sink
        self.null_module = None
        self.loopback_module = None
        self.moved = {}          # sink_input index -> original sink name
        self.stop_flag = threading.Event()
        self.watcher = None

    def matches(self, si):
        binary = (si.get("application.process.binary") or "").lower()
        name = (si.get("application.name") or "").lower()
        return self.match in binary or self.match in name

    def setup(self):
        sink = self.monitor_sink or default_sink()
        if not sink:
            die("Could not read the default sink.")
        self.heard_on = sink
        out = pactl("load-module", "module-null-sink",
                    f"sink_name={NULL_SINK}",
                    "sink_properties=device.description=meetcap-capture")
        self.null_module = (out or "").strip()
        # Loop the captured audio back to the speakers so the meeting stays audible.
        out = pactl("load-module", "module-loopback",
                    f"source={NULL_MONITOR}", f"sink={sink}",
                    "latency_msec=50", check=False)
        self.loopback_module = (out or "").strip() or None
        if not self.loopback_module:
            # Capturing an app removes its audio from your speakers; the
            # loopback is what puts it back. Losing it silently would mean
            # sitting through a meeting unable to hear anyone.
            print("\n  WARNING: could not loop the audio back to your speakers.")
            print("  You will NOT hear this app while recording.")
            print("  Stop and use `meetcap rec` (no --app) instead.\n")
        else:
            print(f"  You will hear it on: {sink_description(sink)}")
        self.reroute()
        self.watcher = threading.Thread(target=self._watch, daemon=True)
        self.watcher.start()

    def reroute(self):
        """Move any matching stream that isn't already in our sink."""
        found = 0
        for si in sink_inputs():
            if not self.matches(si):
                continue
            found += 1
            idx = si["index"]
            if si.get("sink_name_cache") == NULL_SINK or idx in self.moved:
                continue
            origin = si.get("sink", "")
            if pactl("move-sink-input", idx, NULL_SINK, check=False) is not None:
                self.moved[idx] = origin
        return found

    def _watch(self):
        # Apps open new streams mid-call (screen share, a second audio device).
        while not self.stop_flag.wait(0.5):
            try:
                self.reroute()
            except Exception:
                pass

    def wait_for_audio(self, timeout=20):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if any(self.matches(si) for si in sink_inputs()):
                return True
            time.sleep(0.5)
        return False

    def teardown(self):
        self.stop_flag.set()
        if self.watcher:
            self.watcher.join(timeout=2)
        sink = default_sink() or ""
        for idx in list(self.moved):
            pactl("move-sink-input", idx, sink, check=False)
        for mod in (self.loopback_module, self.null_module):
            if mod:
                pactl("unload-module", mod, check=False)


# ------------------------------------------------------------- recording

def ffmpeg_record(source, path, label):
    """Start one ffmpeg capturing a pulse source to WAV. Returns Popen.

    WAV, not FLAC, and deliberately. FLAC buffers: a killed recorder leaves a
    zero-byte file and an hour of meeting is simply gone. WAV is written
    continuously, so even a hard crash leaves a file ffmpeg can still read -
    and the growing byte count is honest proof that audio is flowing.
    16-bit 48kHz mono is ~5.5 MB/minute; compress afterwards with --compress.
    """
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "warning", "-nostdin",
        "-f", "pulse", "-i", source,
        "-ac", "1", "-ar", "48000",
        "-af", "aresample=async=1",
        "-c:a", "pcm_s16le", "-flush_packets", "1",
        "-y", str(path),
    ]
    log = open(str(path) + ".log", "w")
    # start_new_session puts ffmpeg in its own process group, so a Ctrl-C in the
    # terminal does NOT reach it. Only meetcap signals it, exactly once, which
    # is what lets ffmpeg finalize the file instead of aborting on a second
    # signal ("Immediate exit requested").
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                            start_new_session=True)
    proc._meetcap_label = label
    proc._meetcap_log = log
    return proc


def compress(path):
    """Convert a finished WAV to FLAC, keeping the WAV until it verifiably worked."""
    flac = path.with_suffix(".flac")
    r = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin",
                        "-i", str(path), "-c:a", "flac", "-compression_level", "5",
                        "-y", str(flac)], capture_output=True, text=True)
    if r.returncode == 0 and flac.exists() and flac.stat().st_size > 1024:
        path.unlink()
        return flac
    print(f"warning: could not compress {path.name}, keeping the WAV.")
    return path


def peak_of(source, seconds):
    """Record briefly and report peak dBFS, so you can prove a source is live.

    The first second is thrown away. Resuming a suspended PipeWire source emits
    a startup pop that reads as full-scale audio, which would make a dead mic
    look fine - exactly the wrong answer from the command you run to reassure
    yourself before a meeting.
    """
    cmd = ["ffmpeg", "-hide_banner", "-nostdin", "-f", "pulse", "-i", source,
           "-t", str(seconds + 1), "-af", "atrim=start=1,volumedetect",
           "-f", "null", "-"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    m = re.search(r"max_volume:\s*(-?[\d.]+) dB", r.stderr)
    return float(m.group(1)) if m else None


def verdict(peak):
    if peak is None:
        return "NO SIGNAL - ffmpeg captured nothing"
    if peak <= -60:
        return f"peak {peak:.1f} dB - SILENT"
    if peak <= -35:
        return f"peak {peak:.1f} dB - very quiet, check the source"
    return f"peak {peak:.1f} dB - OK"


# ------------------------------------------------------------- commands

def cmd_list(args):
    rows = sink_inputs()
    if not rows:
        print("No applications are playing audio right now.")
        print("Start the meeting (or play any sound in it) and run this again.")
        return
    print(f"{'idx':>4}  {'binary':<22} {'application':<28} media")
    for si in rows:
        name, binary, media = describe_input(si)
        print(f"{si['index']:>4}  {binary:<22} {name:<28} {media[:40]}")
    print("\nRecord one of these with:  meetcap rec --app <binary or name fragment>")


def cmd_mics(args):
    default = (pactl("get-default-source") or "").strip()
    srcs = real_sources()
    if not srcs:
        print("No real (non-monitor) input sources found.")
        return
    print("Microphone sources:")
    for s in srcs:
        mark = "  <- default" if s == default else ""
        print(f"  {pretty_device(source_description(s)):<44} {s}{mark}")
    if default.endswith(".monitor"):
        print(f"\nnote: your default source is '{default}', a monitor, not a mic.")
        print("      meetcap will pick a real one automatically.")


def cmd_check(args):
    """Prove both halves work before the meeting, not during it."""
    require_tools()
    mic = pick_mic(args.mic)
    print(f"Testing microphone: {mic}")
    print(f"  Talk for {args.seconds} seconds...")
    print(f"  {verdict(peak_of(mic, args.seconds))}\n")

    route = None
    if args.app:
        route = AppRoute(args.app, monitor_sink=getattr(args, "monitor_sink", None))
        route.setup()
        if not route.wait_for_audio(10):
            print(f"No audio streams matched '{args.app}'. Run `meetcap list` "
                  f"while the app is making sound.")
            route.teardown()
            return
        source, what = NULL_MONITOR, f"app '{args.app}'"
    else:
        sink = default_sink()
        source, what = f"{sink}.monitor", "system mix"
    try:
        print(f"Testing {what}: {source}")
        print(f"  Make it play sound for {args.seconds} seconds...")
        print(f"  {verdict(peak_of(source, args.seconds))}")
    finally:
        if route:
            route.teardown()
    print("\nBoth lines 'OK' means you are ready to record.")


def require_tools():
    for tool in ("pactl", "ffmpeg"):
        if not shutil.which(tool):
            die(f"'{tool}' not found on PATH. Install it before the meeting.")


SILENCE_DB = -80.0   # below this is digital zero, not a quiet room


def peak_of_file(path, skip=1.0):
    """Peak dBFS of a file we are already writing, without interrupting it."""
    cmd = ["ffmpeg", "-hide_banner", "-nostdin", "-i", str(path),
           "-af", f"atrim=start={skip},volumedetect", "-f", "null", "-"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    m = re.search(r"max_volume:\s*(-?[\d.]+) dB", r.stderr)
    return float(m.group(1)) if m else None


def warn_if_mic_is_silent(mic, mic_path):
    """Refuse to let a switched-off microphone pass as a working one.

    A mic that is present, unmuted and at full gain can still deliver pure
    digital silence - a hardware mute button is enough. It looks identical to a
    working setup right up until you play the recording back, which is far too
    late. A live mic in a quiet room still reads room tone; exact digital zero
    never happens by accident.

    This reads the recording already in progress rather than probing first, so
    checking costs no audio. Never delay the capture to ask whether the capture
    is working.
    """
    peak = peak_of_file(mic_path)
    if peak is None or peak > SILENCE_DB:
        return True

    print()
    print("  " + "!" * 62)
    print("  !!  THIS MICROPHONE IS PRODUCING SILENCE - YOU WILL NOT BE HEARD")
    print("  " + "!" * 62)
    print(f"  {mic}")
    print("  reads pure digital zero, not room tone. Check for a hardware mute")
    print("  button on the mic, its gain knob, and the USB connection.")

    # Safe to probe now: the recorders are already running, so this costs
    # nothing but a moment of our own attention.
    others = [s for s in real_sources() if s != mic]
    working = [s for s in others if (peak_of(s, 2) or -99) > SILENCE_DB]
    if working:
        print("\n  These microphones DO have signal right now:")
        for s in working:
            print(f"    --mic {s}")
    else:
        print("\n  No other microphone has signal either.")
    print("\n  Recording continues - the other side is still worth capturing.")
    print("  Stop with Ctrl-C if you would rather fix the mic first.\n")
    return False


def cmd_rec(args):
    require_tools()
    outdir = Path(args.outdir).expanduser()
    outdir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y-%m-%d_%H%M")
    label = re.sub(r"[^\w.-]+", "-", args.name).strip("-") if args.name else "meeting"
    base = outdir / f"{stamp}_{label}"

    mic = pick_mic(args.mic)

    route = None
    monitored_sink = None
    if args.app:
        print(f"Routing '{args.app}' into a private capture sink...")
        route = AppRoute(args.app, monitor_sink=args.monitor_sink)
        route.setup()
        if not route.wait_for_audio(args.wait):
            print(f"warning: nothing matching '{args.app}' is playing audio yet.")
            print("         Recording anyway - it will pick the app up when it starts.")
        remote_source = NULL_MONITOR
        remote_desc = f"app:{args.app}"
    elif args.follow:
        # Record the monitor of whatever sink the app is on, changing nothing.
        # No null sink, no loopback, no moved streams - so it cannot affect what
        # you hear - while still capturing the device the meeting is actually
        # playing to.
        sink = sink_of_app(args.follow)
        if not sink:
            print(f"warning: no app matching '{args.follow}' is playing audio; "
                  f"falling back to the default output.")
            sink = default_sink()
        if not sink:
            die("Could not resolve a sink to record.")
        print(f"  Following '{args.follow}' on: {sink_description(sink)}")
        monitored_sink = sink
        remote_source = f"{sink}.monitor"
        remote_desc = f"follow:{args.follow}@{sink}"
    else:
        sink = default_sink()
        if not sink:
            die("Could not read the default sink.")
        print(f"  Recording the system mix on: {sink_description(sink)}")
        monitored_sink = sink
        remote_source = f"{sink}.monitor"
        remote_desc = f"system:{sink}"

    mic_path = Path(f"{base}-mic.wav")
    rem_path = Path(f"{base}-remote.wav")

    procs = []
    started = datetime.now()
    try:
        procs.append(ffmpeg_record(mic, mic_path, "mic"))
        procs.append(ffmpeg_record(remote_source, rem_path, "remote"))
        time.sleep(1.5)
        for p in procs:
            if p.poll() is not None:
                print(f"\nERROR: the {p._meetcap_label} recorder died immediately. "
                      f"See {p.args[-1]}.log", file=sys.stderr)

        if not args.no_mic_check:
            # Give the mic a moment of real audio, then judge it.
            time.sleep(2.0)
            warn_if_mic_is_silent(mic, mic_path)
            if monitored_sink:
                warn_if_output_is_silent(monitored_sink)

        print(f"\n  RECORDING -> {base}-*.wav")
        print(f"  mic:    {mic}")
        print(f"  remote: {remote_desc}")
        print("\n  Press Ctrl-C to stop.\n")

        stop = threading.Event()
        signal.signal(signal.SIGINT, lambda *_: stop.set())
        signal.signal(signal.SIGTERM, lambda *_: stop.set())
        while not stop.wait(2):
            elapsed = int((datetime.now() - started).total_seconds())
            sizes = []
            for p, path in ((procs[0], mic_path), (procs[1], rem_path)):
                alive = "" if p.poll() is None else " DEAD"
                kb = path.stat().st_size // 1024 if path.exists() else 0
                sizes.append(f"{p._meetcap_label} {kb:>7} KB{alive}")
            print(f"\r  {elapsed//60:02d}:{elapsed%60:02d}   " + "   ".join(sizes),
                  end="", flush=True)
    finally:
        print("\n\nStopping...")
        for p in procs:
            if p.poll() is None:
                # Exactly one signal, so ffmpeg finalizes rather than aborting.
                p.send_signal(signal.SIGINT)
        for p in procs:
            try:
                p.wait(timeout=15)
            except subprocess.TimeoutExpired:
                print(f"warning: {p._meetcap_label} recorder did not stop; killing it. "
                      f"The WAV is still readable.")
                p.kill()
                p.wait(timeout=5)
            p._meetcap_log.close()
        if route:
            route.teardown()

    ended = datetime.now()

    if args.compress:
        print("Compressing to FLAC...")
        mic_path = compress(mic_path) if mic_path.stat().st_size > 1024 else mic_path
        rem_path = compress(rem_path) if rem_path.stat().st_size > 1024 else rem_path

    meta = {
        "name": args.name or "meeting",
        "started": started.isoformat(timespec="seconds"),
        "ended": ended.isoformat(timespec="seconds"),
        "duration_seconds": int((ended - started).total_seconds()),
        "mic_source": mic,
        "remote_source": remote_desc,
        "files": {"mic": mic_path.name, "remote": rem_path.name},
        "transcripts": {},
    }
    meta_path = Path(f"{base}.json")
    meta_path.write_text(json.dumps(meta, indent=2) + "\n")

    print(f"Saved to {outdir}:")
    for p in (mic_path, rem_path):
        if p.exists() and p.stat().st_size > 44 * 1024:
            print(f"  {p.name}  ({p.stat().st_size/1_000_000:.1f} MB)")
        else:
            print(f"  {p.name}  -- EMPTY OR SILENT, see {p.name}.log")
    print(f"  {meta_path.name}")


def main():
    ap = argparse.ArgumentParser(
        prog="meetcap", description="Record meeting audio for transcription.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="show applications currently playing audio")
    sub.add_parser("mics", help="show microphone sources")

    c = sub.add_parser("check", help="verify mic and meeting audio before you rely on them")
    c.add_argument("--app", help="application to test (binary or name fragment)")
    c.add_argument("--mic", help="microphone source name")
    c.add_argument("--seconds", type=int, default=5)
    c.add_argument("--monitor-sink", dest="monitor_sink",
                   help="where you would hear the captured app")

    r = sub.add_parser("rec", help="record until Ctrl-C")
    r.add_argument("--app", help="record ONLY this app (reroutes its audio through "
                                 "a private sink; isolates best)")
    r.add_argument("--follow", metavar="APP",
                   help="record the output device this app is using, without "
                        "rerouting anything (safest: cannot affect what you hear, "
                        "and cannot miss an app that is not on your default output)")
    r.add_argument("--mic", help="microphone source name")
    r.add_argument("--name", default="meeting", help="label for the filenames")
    r.add_argument("--outdir", default=str(DEFAULT_OUTDIR))
    r.add_argument("--no-mic-check", action="store_true",
                   help="skip the startup test that the microphone is not silent")
    r.add_argument("--monitor-sink", dest="monitor_sink",
                   help="where YOU hear the captured app (default: your default "
                        "output). Useful if the default device is unreliable.")
    r.add_argument("--compress", action="store_true",
                   help="convert to FLAC after a clean stop (WAV is kept if it fails)")
    r.add_argument("--wait", type=int, default=20,
                   help="seconds to wait for the app's audio before starting anyway")

    args = ap.parse_args()
    {"list": cmd_list, "mics": cmd_mics, "check": cmd_check, "rec": cmd_rec}[args.cmd](args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ctrl-C before the recorders are up is a normal way to stop, not a crash.
        print("\ninterrupted", file=sys.stderr)
        sys.exit(130)
