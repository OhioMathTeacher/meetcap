#!/usr/bin/env python3
"""meetcap-app - the meeting recorder with a window.

A front-end over the command-line tools, not a reimplementation of them. The
capture path is the one that has actually been tested against real hardware, so
the app drives `meetcap` and `meetcap-transcribe` as subprocesses rather than
growing a second copy of the audio logic that could drift from it.

What it gives you over the CLI: your recordings in a list, a model picker, and
the transcript readable next to the recording it came from.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
from datetime import datetime
from importlib.machinery import SourceFileLoader
from pathlib import Path

from PyQt6.QtCore import Qt, QProcess, QRectF, QTimer, QUrl
from PyQt6.QtGui import (QColor, QPainter, QPainterPath, QPen, QPixmap,
                         QTextCharFormat, QTextCursor, QTextDocument,
                         QTextOption)
from PyQt6.QtMultimedia import QAudioOutput, QMediaPlayer
from PyQt6.QtPrintSupport import QPrinter
from PyQt6.QtWidgets import (
    QApplication, QComboBox, QFileDialog, QFrame, QHBoxLayout, QHeaderView,
    QLabel, QLineEdit, QMainWindow, QMessageBox, QPushButton, QSlider,
    QSplitter, QTableWidget, QTableWidgetItem, QTextBrowser, QTextEdit,
    QVBoxLayout, QWidget,
)

HERE = Path(__file__).resolve().parent
MEETINGS = Path(os.environ.get("MEETCAP_OUT", Path.home() / "Recordings" / "meetings"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "meetcap"
MODELS = ["auto", "tiny", "base", "small", "medium", "large-v3"]

SILENCE_DB = -80.0
QUIET_DB = -55.0

# Audio clients that are infrastructure, not something you would ever want to
# record: screen-reader plumbing, UI event sounds, and meetcap's own probes.
NOT_USER_APPS = {
    "speech-dispatcher", "speech-dispatcher-dummy", "sd_dummy", "sd_espeak",
    "libcanberra", "canberra-gtk-play", "pulseaudio", "pipewire",
    "wireplumber", "meetcap", "gsd-media-keys", "nemo-desktop", "plasmashell",
    "xfdesktop", "gnome-shell",
}


def is_user_app(name, binary):
    """Keep the applications a person would recognise on screen."""
    for candidate in (name or "", binary or ""):
        if candidate.strip().lower() in NOT_USER_APPS:
            return False
    return True


def load_cli(name):
    """Import a CLI script as a module so device logic is shared, not copied."""
    import importlib.util
    path = HERE / name
    modname = name.replace("-", "_")
    # spec_from_file_location cannot type an extensionless file, so name the
    # loader explicitly. load_module() is deprecated and gone in newer Pythons.
    loader = SourceFileLoader(modname, str(path))
    spec = importlib.util.spec_from_loader(modname, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)             # scripts guard their own main()
    return mod


try:
    mc = load_cli("meetcap")
except Exception as e:                  # pragma: no cover - surfaced in the UI
    mc = None
    _load_error = e


def transcript_html(md):
    """Render a transcript as HTML we control.

    setMarkdown discards the document stylesheet, which left every speaker
    label jammed against the speech under it. The format is ours and it is
    simple, so rendering it directly is both shorter and legible.
    """
    import html as _html
    out = ["<div style='font-family:sans-serif;'>"]
    for raw in md.splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("# "):
            out.append(f"<div style='font-size:21px;font-weight:bold;"
                       f"color:#e8eaed;padding-bottom:2px;'>"
                       f"{_html.escape(line[2:])}</div>")
        elif line.startswith("*") and line.endswith("*") and "**" not in line:
            out.append(f"<div style='color:#9aa0a8;font-size:12px;"
                       f"padding-bottom:14px;'>"
                       f"{_html.escape(line.strip('*'))}</div>")
        elif line.startswith("**"):
            who, _, when = line.partition("·")
            who = who.replace("*", "").strip()
            out.append(f"<div style='margin-top:18px;'>"
                       f"<span style='color:#5b9dd9;font-weight:bold;'>"
                       f"{_html.escape(who)}</span>"
                       f"<span style='color:#6b7178;'>&nbsp;&nbsp;"
                       f"{_html.escape(when.strip())}</span></div>")
        else:
            out.append(f"<p style='color:#c9ced8;margin:4px 0 0 0;'>"
                       f"{_html.escape(line)}</p>")
    out.append("</div>")
    return "\n".join(out)


def _fmt(size=None, color=None, bold=False):
    f = QTextCharFormat()
    if size:
        f.setFontPointSize(size)
    if color:
        f.setForeground(QColor(color))
    if bold:
        f.setFontWeight(700)
    return f


def fill_transcript(doc, segs, title="", subtitle="", printing=False):
    """Write the transcript into `doc`, remembering where every moment landed.

    Returns the marks: a time-ordered list of
    ``(start_ms, end_ms, char_start, char_end)`` covering one word each when the
    transcript carries word timings and one segment each when it does not. That
    is what lets playback follow along at whichever resolution the data actually
    supports, instead of demanding a re-transcription before anything works.

    `printing` swaps to ink on paper - the same document, built once, is what
    both the viewer and the PDF are made of.
    """
    ink   = "#111111" if printing else "#c9ced8"
    head  = "#000000" if printing else "#e8eaed"
    muted = "#555555" if printing else "#9aa0a8"
    who_c = "#1a4f8a" if printing else "#5b9dd9"
    when_c = "#777777" if printing else "#6b7178"

    doc.clear()
    cur = QTextCursor(doc)
    cur.beginEditBlock()
    marks = []

    if title:
        cur.insertText(title, _fmt(16 if printing else 15, head, bold=True))
    if subtitle:
        cur.insertBlock()
        cur.insertText(subtitle, _fmt(9, muted))

    last_speaker = None
    for seg in segs:
        speaker = seg.get("speaker") or ""
        if speaker != last_speaker:
            cur.insertBlock()
            cur.insertBlock()
            cur.insertText(speaker, _fmt(10, who_c, bold=True))
            secs = int(seg.get("start") or 0)
            cur.insertText(f"   {secs // 60}:{secs % 60:02d}", _fmt(9, when_c))
            last_speaker = speaker
        cur.insertBlock()

        body = _fmt(10.5, ink)
        words = seg.get("words") or []
        if words:
            for w in words:
                text = w.get("word", "")
                if not text:
                    continue
                start = cur.position()
                cur.insertText(text, body)
                marks.append((int(float(w["start"]) * 1000),
                              int(float(w["end"]) * 1000), start, cur.position()))
        else:
            start = cur.position()
            cur.insertText(seg.get("text", ""), body)
            marks.append((int(float(seg.get("start") or 0) * 1000),
                          int(float(seg.get("end") or 0) * 1000),
                          start, cur.position()))

    cur.endEditBlock()
    marks.sort(key=lambda m: m[0])
    return marks


def transcriber():
    """The transcribe entry point that knows which python has whisper."""
    return shutil.which("meetcap-transcribe") or str(HERE / "meetcap-transcribe")


