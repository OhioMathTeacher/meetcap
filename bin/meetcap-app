def arrow_icon():
    """Draw the pulldown arrow to a file and return its path.

    Qt's stylesheet engine will not build a triangle out of CSS borders - it
    renders the block instead - and without a visible arrow every combo box
    reads as a plain text field, so nobody discovers it is a pulldown.
    """
    import tempfile
    pix = QPixmap(22, 14)
    pix.fill(QColor(0, 0, 0, 0))
    painter = QPainter(pix)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    path = QPainterPath()
    path.moveTo(5, 5)
    path.lineTo(17, 5)
    path.lineTo(11, 11)
    path.closeSubpath()
    painter.fillPath(path, QColor("#9aa0a8"))
    painter.end()
    out = Path(tempfile.gettempdir()) / "meetcap_arrow.png"
    pix.save(str(out))
    return out.as_posix()


class LevelBar(QWidget):
    """A segmented LED level meter with proper ballistics.

    Two things make a meter readable. It repaints on its own clock rather than
    whenever audio happens to arrive - that is what caused the flicker - and it
    rises instantly but falls slowly, so a syllable leaves a visible trace
    instead of a flash. The peak-hold tick sits at the loudest recent moment.
    """

    FLOOR = -60.0
    SEGMENTS = 22
    RELEASE_DB = 0.85      # per frame, ~26 dB/second
    PEAK_HOLD_MS = 1100

    def __init__(self, label=""):
        super().__init__()
        self.label = label
        self._target = -99.0     # newest reading from the audio tap
        self.db = -99.0          # what is actually drawn, after ballistics
        self.peak = -99.0
        self._peak_age = 0
        self.setMinimumSize(196, 26)
        self._frame = QTimer(self)
        self._frame.timeout.connect(self._advance)
        self._frame.start(33)                     # ~30fps, independent of audio

    def set_db(self, db):
        """Called from the audio tap; only records the value."""
        self._target = db

    def _advance(self):
        # Instant attack, slow release - the way a stereo meter behaves.
        if self._target >= self.db:
            self.db = self._target
        else:
            self.db = max(self.db - self.RELEASE_DB, self._target, -99.0)
        if self.db >= self.peak:
            self.peak = self.db
            self._peak_age = 0
        else:
            self._peak_age += 33
            if self._peak_age > self.PEAK_HOLD_MS:
                self.peak = max(self.peak - self.RELEASE_DB * 0.6, self.db, -99.0)
        self.update()

    def _lit_count(self, db):
        if db <= self.FLOOR:
            return 0
        frac = max(0.0, min(1.0, (db - self.FLOOR) / (0.0 - self.FLOOR)))
        return int(round(frac * self.SEGMENTS))

    def _segment_colour(self, i):
        if i >= self.SEGMENTS - 2:
            return QColor("#e2564a")          # red: clipping
        if i >= int(self.SEGMENTS * 0.78):
            return QColor("#e0a53f")          # amber: hot
        return QColor("#4fbe63")              # green: good

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, False)
        w, h = self.width(), self.height()
        gap = 2.0
        seg_w = (w - gap * (self.SEGMENTS - 1)) / self.SEGMENTS
        top, bar_h = h / 2 - 6, 12.0

        lit = self._lit_count(self.db)
        peak_seg = self._lit_count(self.peak) - 1
        p.setPen(Qt.PenStyle.NoPen)

        for i in range(self.SEGMENTS):
            x = i * (seg_w + gap)
            colour = self._segment_colour(i)
            if i < lit:
                p.setBrush(colour)
            elif i == peak_seg and peak_seg >= 0:
                p.setBrush(colour.darker(135))    # peak hold sits on the ladder
            else:
                unlit = QColor(colour)
                unlit.setAlpha(38)                # the ladder stays visible
                p.setBrush(unlit)
            p.drawRect(QRectF(x, top, seg_w, bar_h))
        p.end()


class LevelTap:
    """Streams raw samples from one PulseAudio source and reports peaks."""

    def __init__(self, on_level):
        self.on_level = on_level
        self.proc = None

    def start(self, source):
        self.stop()
        if not source or not shutil.which("parec"):
            return
        self.proc = QProcess()
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.start("parec", ["--device", source, "--format=s16le",
                                  "--rate=8000", "--channels=1", "--latency-msec=50"])

    def _read(self):
        import array
        data = bytes(self.proc.readAllStandardOutput())
        if len(data) < 2:
            return
        samples = array.array("h")
        samples.frombytes(data[: len(data) // 2 * 2])
        peak = max((abs(v) for v in samples), default=0)
        import math
        db = -99.0 if peak == 0 else 20 * math.log10(peak / 32768.0)
        self.on_level(db)

    def stop(self):
        if self.proc:
            self.proc.kill()
            self.proc.waitForFinished(1000)
            self.proc = None


class Card(QFrame):
    def __init__(self):
        super().__init__()
        self.setObjectName("card")


class MeetcapWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("meetcap")
        self.resize(1180, 800)
        self.rec_proc = None
        self.tr_proc = None
        self.started_at = None

        root = QWidget()
        self.setCentralWidget(root)
        lay = QVBoxLayout(root)
        lay.setContentsMargins(20, 20, 20, 14)
        lay.setSpacing(16)

        lay.addWidget(self._record_card())

        split = QSplitter(Qt.Orientation.Horizontal)
        split.addWidget(self._library_panel())
        split.addWidget(self._viewer_panel())
        split.setSizes([560, 620])
        lay.addWidget(split, 1)

        self.status = QLabel("Ready.")
        self.status.setObjectName("muted")
        lay.addWidget(self.status)

        self.tick = QTimer(self)
        self.tick.timeout.connect(self._on_tick)

        self.audio_out = QAudioOutput()
        self.marks = []          # (start_ms, end_ms, char_start, char_end)
        self.mark_at = -1
        self.player = QMediaPlayer()
        self.player.setAudioOutput(self.audio_out)
        self.player.positionChanged.connect(self._on_position)
        self.player.durationChanged.connect(self._on_duration)
        self.player.playbackStateChanged.connect(self._on_play_state)

        self.mic_tap = LevelTap(self.mic_meter.set_db)
        self.out_tap = LevelTap(self.out_meter.set_db)

        self.refresh_devices()
        self.refresh_outputs()
        self.refresh_apps()
        self.reload()

        self.mic.currentIndexChanged.connect(self.restart_taps)
        self.out_dev.currentIndexChanged.connect(self.restart_taps)
        if not os.environ.get("MEETCAP_SHOT"):
            QTimer.singleShot(400, self.restart_taps)
        self.state_timer = QTimer(self)
        self.state_timer.timeout.connect(self.refresh_output_state)
        self.state_timer.start(2000)

    # ---------------------------------------------------------- record card

    def _record_card(self):
        card = Card()
        v = QVBoxLayout(card)
        v.setContentsMargins(20, 16, 20, 18)
        v.setSpacing(11)

        v.addWidget(self._label("RECORD", "h"))

        row = QHBoxLayout()
        row.addWidget(self._label("Name"))
        self.name = QLineEdit("meeting")
        self.name.setMaximumWidth(190)
        row.addWidget(self.name)

        row.addWidget(self._label("Capture"))
        self.mode = QComboBox()
        self.mode.addItems([
            "Follow an app's device (safest)",
            "Whole system mix",
            "Only this app (isolated)",
        ])
        self.mode.setMinimumWidth(210)
        row.addWidget(self.mode)

        # Editable on purpose: an app only appears here once it is actually
        # playing audio, and you usually set this up before the meeting makes
        # any sound. Typing a name that is not in the list is normal - the
        # recorder waits for it and picks it up when it starts.
        self.app_name = QComboBox()
        self.app_name.setEditable(True)
        self.app_name.setMinimumWidth(230)
        self.app_name.setToolTip(
            "Applications currently playing audio. Type a name if the app is "
            "not making sound yet - Zoom before the call starts, for example.")
        row.addWidget(self.app_name)

        self.apps_btn = QPushButton("Refresh apps")
        self.apps_btn.clicked.connect(self.refresh_apps)
        row.addWidget(self.apps_btn)
        row.addStretch(1)
        v.addLayout(row)

        row2 = QHBoxLayout()
        row2.addWidget(self._label("Microphone"))
        self.mic = QComboBox()
        self.mic.setMinimumWidth(420)
        row2.addWidget(self.mic, 1)

        self.test_btn = QPushButton("Test mic")
        self.test_btn.clicked.connect(self.test_mic)
        row2.addWidget(self.test_btn)

        self.mic_meter = LevelBar("in")
        row2.addWidget(self.mic_meter)

        self.level = QLabel("")
        self.level.setMinimumWidth(112)
        row2.addWidget(self.level)

        self.rec_btn = QPushButton("Start recording")
        self.rec_btn.setObjectName("record")
        self.rec_btn.clicked.connect(self.toggle_record)
        row2.addWidget(self.rec_btn)
        v.addLayout(row2)

        row3 = QHBoxLayout()
        row3.addWidget(self._label("Output"))
        self.out_dev = QComboBox()
        self.out_dev.setMinimumWidth(360)
        row3.addWidget(self.out_dev, 1)

        self.out_meter = LevelBar("out")
        row3.addWidget(self.out_meter)

        self.out_state = QLabel("")
        self.out_state.setObjectName("muted")
        self.out_state.setMinimumWidth(112)
        row3.addWidget(self.out_state)
        v.addLayout(row3)

        self.rec_status = QLabel(
            "Output is where you hear the meeting. Test the microphone before "
            "a meeting you cannot repeat.")
        self.rec_status.setObjectName("muted")
        v.addWidget(self.rec_status)
        return card

    def _label(self, text, obj="muted"):
        lbl = QLabel(text)
        lbl.setObjectName(obj)
        return lbl

    # ------------------------------------------------------------- library

    def _library_panel(self):
        card = Card()
        v = QVBoxLayout(card)
        v.setContentsMargins(20, 16, 20, 18)
        v.setSpacing(12)

        head = QHBoxLayout()
        head.addWidget(self._label("RECORDINGS", "h"))
        head.addStretch(1)
        self.count_lbl = QLabel("")
        self.count_lbl.setObjectName("muted")
        head.addWidget(self.count_lbl)
        self.filter = QLineEdit()
        self.filter.setPlaceholderText("Filter by name or date\u2026")
        self.filter.setClearButtonEnabled(True)
        self.filter.setMaximumWidth(230)
        self.filter.textChanged.connect(self.apply_filter)
        head.addWidget(self.filter)
        v.addLayout(head)

        self.table = QTableWidget(0, 5)
        self.table.setHorizontalHeaderLabels(
            ["When", "Name", "Length", "Transcript", ""])
        self.table.verticalHeader().setVisible(False)
        self.table.verticalHeader().setDefaultSectionSize(38)
        self.table.setShowGrid(False)
        self.table.setSelectionBehavior(
            QTableWidget.SelectionBehavior.SelectRows)
        self.table.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)
        h = self.table.horizontalHeader()
        h.setSectionResizeMode(0, QHeaderView.ResizeMode.ResizeToContents)
        h.setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        h.setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        h.setSectionResizeMode(3, QHeaderView.ResizeMode.ResizeToContents)
        h.setSectionResizeMode(4, QHeaderView.ResizeMode.ResizeToContents)
        self.table.itemSelectionChanged.connect(self.show_selected_transcript)
        v.addWidget(self.table, 1)

        # Transport: reviewing a recording should not mean leaving the app.
        trow = QHBoxLayout()
        self.play_btn = QPushButton("\u25b6  Play")
        self.play_btn.clicked.connect(self.toggle_play)
        trow.addWidget(self.play_btn)

        back = QPushButton("\u00ab 10s")
        back.setToolTip("Back 10 seconds")
        back.setMaximumWidth(70)
        back.clicked.connect(lambda: self.seek_by(-10_000))
        trow.addWidget(back)

        fwd = QPushButton("10s \u00bb")
        fwd.setToolTip("Forward 10 seconds")
        fwd.setMaximumWidth(70)
        fwd.clicked.connect(lambda: self.seek_by(10_000))
        trow.addWidget(fwd)

        stop = QPushButton("\u25a0")
        stop.setMaximumWidth(46)
        stop.setToolTip("Stop")
        stop.clicked.connect(self.stop_play)
        trow.addWidget(stop)

        self.seek = QSlider(Qt.Orientation.Horizontal)
        self.seek.setRange(0, 0)
        self.seek.sliderMoved.connect(self.player_seek)
        trow.addWidget(self.seek, 1)

        self.clock = QLabel("0:00 / 0:00")
        self.clock.setObjectName("muted")
        self.clock.setMinimumWidth(96)
        trow.addWidget(self.clock)

        v.addLayout(trow)

        row = QHBoxLayout()
        row.addWidget(self._label("Listen to"))
        self.track = QComboBox()
        self.track.addItems(["Both", "Meeting", "You"])
        self.track.currentIndexChanged.connect(self.reload_track)
        row.addWidget(self.track)

        row.addSpacing(16)
        row.addWidget(self._label("Model"))
        self.model = QComboBox()
        self.model.addItems(MODELS)
        row.addWidget(self.model)

        self.tr_btn = QPushButton("Transcribe")
        self.tr_btn.clicked.connect(self.transcribe_selected)
        row.addWidget(self.tr_btn)

        self.pdf_btn = QPushButton("Export PDF")
        self.pdf_btn.setToolTip("Save this transcript as a PDF")
        self.pdf_btn.setEnabled(False)
        self.pdf_btn.clicked.connect(self.export_pdf)
        row.addWidget(self.pdf_btn)

        folder = QPushButton("Open folder")
        folder.clicked.connect(
            lambda: subprocess.Popen(["xdg-open", str(MEETINGS)]))
        row.addWidget(folder)

        refresh = QPushButton("Refresh")
        refresh.clicked.connect(self.reload)
        row.addWidget(refresh)
        row.addStretch(1)
        v.addLayout(row)
        return card

    def _viewer_panel(self):
        card = Card()
        v = QVBoxLayout(card)
        v.setContentsMargins(20, 16, 20, 18)
        v.setSpacing(12)
        self.viewer_title = self._label("TRANSCRIPT", "h")
        v.addWidget(self.viewer_title)
        self.viewer = QTextBrowser()
        self.viewer.setOpenExternalLinks(True)
        self.viewer.setWordWrapMode(QTextOption.WrapMode.WordWrap)

        self.viewer.setMarkdown(
            "Select a recording to read its transcript.\n\n"
            "If it has none yet, choose a model and press **Transcribe**.")
        v.addWidget(self.viewer, 1)
        return card

    # ------------------------------------------------------------- devices

    def refresh_devices(self):
        self.mic.clear()
        if not mc:
            self.mic.addItem("(meetcap not importable)")
            return
        try:
            sources = mc.real_sources()
            default = (mc.pactl("get-default-source") or "").strip()
        except (Exception, SystemExit):
            # die() exits; a GUI should say so, not vanish.
            sources, default = [], ""
        if not sources:
            self.mic.addItem("(no microphone found - is the audio server running?)")
            return
        try:
            names = mc.device_descriptions("sources")
        except (Exception, SystemExit):
            names = {}
        for s in sources:
            label = mc.pretty_device(names.get(s, s))
            self.mic.addItem(("\u25cf " if s == default else "   ") + label, s)
            self.mic.setItemData(self.mic.count() - 1, s, Qt.ItemDataRole.ToolTipRole)

    def selected_mic(self):
        return self.mic.currentData()

    def selected_output(self):
        return self.out_dev.currentData()

    def selected_app(self):
        """What to match on: the stored binary/name, or whatever was typed."""
        idx = self.app_name.currentIndex()
        typed = self.app_name.currentText().strip()
        if idx >= 0 and self.app_name.itemText(idx) == typed:
            return self.app_name.itemData(idx) or typed
        return typed

    @staticmethod
    def _windowed_apps():
        """Running applications that have a window, via wmctrl's WM_CLASS.

        Apps only show up in the audio list once they make a sound, so Zoom
        sitting idle before a call would be invisible. This is the rest of the
        answer to 'what is running right now'.
        """
        if not shutil.which("wmctrl"):
            return []
        try:
            r = subprocess.run(["wmctrl", "-lx"], capture_output=True,
                               text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return []
        if r.returncode != 0:
            return []
        found = {}
        for line in r.stdout.splitlines():
            parts = line.split(None, 4)
            if len(parts) < 3 or "." not in parts[2]:
                continue
            _instance, _, klass = parts[2].partition(".")
            klass = klass.strip()
            # WM_CLASS is instance.class, and the instance is often useless for
            # matching: Firefox reports "Navigator", which would never match the
            # audio stream from the "firefox" process. The last segment of the
            # class is the name the rest of the system uses.
            match = klass.split(".")[-1].lower()
            if not match or match in found or not is_user_app(match, match):
                continue
            found[match] = klass.split(".")[-1]
        return sorted(found.items())

    def refresh_apps(self):
        """Everything you could plausibly record: making sound, or just open."""
        current = self.app_name.currentText().strip()
        self.app_name.clear()

        audible = []
        try:
            for si in mc.sink_inputs():
                name = (si.get("application.name") or "").strip()
                binary = (si.get("application.process.binary") or "").strip()
                if not name and not binary:
                    continue
                if not is_user_app(name, binary):
                    continue
                audible.append((f"{name or binary}  - playing audio",
                                binary or name))
        except (Exception, SystemExit):
            pass

        seen = {m.lower() for _, m in audible}
        running = [(f"{klass}  - running", inst)
                   for inst, klass in self._windowed_apps()
                   if inst not in seen]

        for label, match in audible + running:
            self.app_name.addItem(label, match)
        if not (audible or running):
            self.app_name.addItem("(nothing detected - type a name)", "")
        self.app_name.setEditText(current or "zoom")

    def refresh_outputs(self):
        self.out_dev.clear()
        if not mc:
            return
        try:
            default = (mc.pactl("get-default-sink") or "").strip()
            raw = mc.pactl("list", "short", "sinks") or ""
        except (Exception, SystemExit):
            default, raw = "", ""
        try:
            names = mc.device_descriptions("sinks")
        except (Exception, SystemExit):
            names = {}
        for line in raw.strip().splitlines():
            parts = line.split("\t")
            if len(parts) < 2:
                continue
            name = parts[1]
            label = mc.pretty_device(names.get(name, name))
            self.out_dev.addItem(("\u25cf " if name == default else "   ") + label,
                                 name)
            self.out_dev.setItemData(self.out_dev.count() - 1, name,
                                     Qt.ItemDataRole.ToolTipRole)
        if not self.out_dev.count():
            self.out_dev.addItem("(no output devices found)")

    def restart_taps(self):
        """Listen to whichever devices are selected, live."""
        self.mic_tap.start(self.selected_mic())
        sink = self.selected_output()
        self.out_tap.start(f"{sink}.monitor" if sink else None)
        self.refresh_output_state()

    def refresh_output_state(self):
        """Muted output records silence from everyone else - say so, always."""
        sink = self.selected_output()
        if not sink or not mc:
            return
        try:
            muted, vol = mc.sink_state(sink)
        except (Exception, SystemExit):
            return
        if muted:
            self.out_state.setText("MUTED - records silence")
            self.out_state.setStyleSheet("color: #cc554c; font-weight: 600;")
        elif vol is not None and vol < 40:
            self.out_state.setText(f"{vol}% - quiet")
            self.out_state.setStyleSheet("color: #d8a657;")
        elif vol is not None:
            self.out_state.setText(f"{vol}%")
            self.out_state.setStyleSheet("color: #838b98;")

    def closeEvent(self, event):
        self.mic_tap.stop()
        self.out_tap.stop()
        super().closeEvent(event)

    def test_mic(self):
        """Prove the mic is live before trusting it - the AT2020 lesson."""
        src = self.selected_mic()
        if not src or not mc:
            return
        self.level.setText("testing...")
        QApplication.processEvents()
        peak = mc.peak_of(src, 2)
        if peak is None:
            self.level.setText("no signal")
            colour = "#d1615a"
        elif peak <= SILENCE_DB:
            self.level.setText(f"SILENT ({peak:.0f} dB) - switched off?")
            colour = "#d1615a"
        elif peak <= QUIET_DB:
            self.level.setText(f"very quiet ({peak:.0f} dB)")
            colour = "#d8a657"
        else:
            self.level.setText(f"OK ({peak:.0f} dB)")
            colour = "#5fb85f"
        self.level.setStyleSheet(f"color: {colour};")

    # ------------------------------------------------------------ recording

    def toggle_record(self):
        if self.rec_proc:
            self.stop_record()
        else:
            self.start_record()

    def start_record(self):
        MEETINGS.mkdir(parents=True, exist_ok=True)
        args = ["rec", "--name", self.name.text().strip() or "meeting",
                "--outdir", str(MEETINGS)]
        mode = self.mode.currentIndex()
        app = self.selected_app() or "zoom"
        if mode == 0:
            args += ["--follow", app]
        elif mode == 2:
            args += ["--app", app]
        mic = self.selected_mic()
        if mic:
            args += ["--mic", mic]
        # Only isolated capture reroutes audio, so only it needs to be told
        # where to send it back.
        if mode == 2 and self.selected_output():
            args += ["--monitor-sink", self.selected_output()]

        self.rec_proc = QProcess(self)
        self.rec_proc.setProcessChannelMode(
            QProcess.ProcessChannelMode.MergedChannels)
        self.rec_proc.readyRead.connect(self._read_rec)
        self.rec_proc.finished.connect(self._rec_finished)
        self.rec_proc.start(str(HERE / "meetcap"), args)

        self.started_at = datetime.now()
        self.tick.start(1000)
        self.rec_btn.setText("Stop recording")
        self.rec_btn.setObjectName("stop")
        self.rec_btn.setStyleSheet("")
        self.setStyleSheet(QApplication.instance().styleSheet())
        self._set_inputs_enabled(False)
        self.status.setText("Recording...")

    def stop_record(self):
        """SIGINT, not terminate - it is what lets ffmpeg finalize the files."""
        if not self.rec_proc:
            return
        pid = int(self.rec_proc.processId())
        if pid > 0:
            try:
                os.kill(pid, signal.SIGINT)
            except OSError:
                self.rec_proc.terminate()
        self.status.setText("Stopping...")

    def _read_rec(self):
        if not self.rec_proc:
            return
        text = bytes(self.rec_proc.readAll()).decode(errors="replace")
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            if "SILENCE" in line or "WARNING" in line:
                self.rec_status.setStyleSheet("color: #d1615a;")
                self.rec_status.setText(line.strip("! "))
            elif line.startswith(("You will hear", "Following", "Recording the")):
                self.rec_status.setStyleSheet("color: #9aa0a8;")
                self.rec_status.setText(line)

    def _rec_finished(self):
        self.tick.stop()
        self.rec_proc = None
        self.rec_btn.setText("Start recording")
        self.rec_btn.setObjectName("record")
        self.setStyleSheet(QApplication.instance().styleSheet())
        self._set_inputs_enabled(True)
        self.status.setText("Recording saved.")
        self.reload()

    def _set_inputs_enabled(self, on):
        for w in (self.name, self.mode, self.app_name, self.apps_btn, self.mic,
                  self.out_dev, self.test_btn, self.tr_btn):
            w.setEnabled(on)

    def _on_tick(self):
        if not self.started_at:
            return
        secs = int((datetime.now() - self.started_at).total_seconds())
        self.status.setText(f"Recording   {secs // 60:02d}:{secs % 60:02d}")

    # ----------------------------------------------------------- playback

    @staticmethod
    def _mmss(ms):
        secs = max(0, ms // 1000)
        return f"{secs // 60}:{secs % 60:02d}"

    def track_path(self, rec):
        """The chosen side of the recording - they are separate files."""
        if not rec:
            return None
        choice = self.track.currentText()
        if choice == "Both":
            mixed = self.mixed_path(rec)
            if mixed:
                return mixed                 # fall through if mixing failed
        want = "-mic" if choice == "You" else "-remote"
        audio = rec["audio"]
        cand = audio.with_name(audio.name.replace("-mic", want))
        return cand if cand.exists() else audio

    def mixed_path(self, rec):
        """Both sides as one track - the mixdown a two-track recorder needs.

        Capture keeps the sides apart on purpose: it survives one recorder
        dying and it is what gives the transcript its speaker labels. But
        nobody wants to listen to half a conversation, so the two are summed on
        demand and cached. The recordings themselves are never touched.

        The pair is safe to sum: both recorders start together and ffmpeg
        writes them to the same clock, so they come back with an identical
        sample count and no drift to correct for.
        """
        mic = rec["audio"]
        rem = mic.with_name(mic.name.replace("-mic", "-remote"))
        if not rem.exists():
            return None                      # only one side was ever recorded

        out = CACHE / f"{rec['stem']}-both.wav"
        try:
            if (out.exists()
                    and out.stat().st_mtime >= max(mic.stat().st_mtime,
                                                   rem.stat().st_mtime)):
                return out
            CACHE.mkdir(parents=True, exist_ok=True)
        except OSError:
            return None

        self.status.setText("Mixing both tracks\u2026")
        QApplication.setOverrideCursor(Qt.CursorShape.BusyCursor)
        QApplication.processEvents()
        try:
            # normalize=0 keeps each voice at the level it was recorded at
            # (amix halves them otherwise); the limiter catches the moments
            # you both talk at once rather than letting them clip.
            #
            # Measured: the result is the plain sum of the two tracks
            # (correlation 1.000), delayed 79 samples - 4.9 ms - by the
            # limiter's lookahead. Inaudible, and far under the resolution of
            # the transcript timings, so the highlight stays in step. Do not
            # go chasing it as drift.
            r = subprocess.run(
                ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin",
                 "-i", str(mic), "-i", str(rem), "-filter_complex",
                 "[0:a][1:a]amix=inputs=2:duration=longest:normalize=0,"
                 "alimiter=limit=0.95",
                 "-ac", "1", "-c:a", "pcm_s16le", "-y", str(out)],
                capture_output=True, text=True)
        except OSError as e:
            self.status.setText(f"Could not mix: {e}")
            return None
        finally:
            QApplication.restoreOverrideCursor()

        if r.returncode != 0 or not out.exists():
            out.unlink(missing_ok=True)
            self.status.setText("Could not mix the two tracks; playing one side.")
            return None
        self.status.setText("Ready.")
        return out

    def toggle_play(self):
        if self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState:
            self.player.pause()
            return
        if self.player.source().isEmpty():
            path = self.track_path(self.current_recording())
            if not path:
                return
            self.player.setSource(QUrl.fromLocalFile(str(path)))
        self.player.play()

    def stop_play(self):
        self.player.stop()

    def seek_by(self, delta_ms):
        self.player.setPosition(max(0, self.player.position() + delta_ms))

    def player_seek(self, value):
        self.player.setPosition(value)

    def reload_track(self):
        """Switching side keeps your place, so you can compare the two."""
        was = self.player.playbackState() == QMediaPlayer.PlaybackState.PlayingState
        pos = self.player.position()
        path = self.track_path(self.current_recording())
        if not path:
            return
        self.player.setSource(QUrl.fromLocalFile(str(path)))
        self.player.setPosition(pos)
        if was:
            self.player.play()

    def _on_position(self, pos):
        if not self.seek.isSliderDown():
            self.seek.setValue(pos)
        self._follow(pos)
        self.clock.setText(f"{self._mmss(pos)} / {self._mmss(self.player.duration())}")

    def _on_duration(self, dur):
        self.seek.setRange(0, dur)
        self.clock.setText(f"{self._mmss(self.player.position())} / {self._mmss(dur)}")

    def _on_play_state(self, state):
        playing = state == QMediaPlayer.PlaybackState.PlayingState
        self.play_btn.setText("\u23f8  Pause" if playing else "\u25b6  Play")

    # ---------------------------------------------------------- transcribe

    def transcribe_selected(self):
        rec = self.current_recording()
        if not rec:
            return
        if self.tr_proc:
            QMessageBox.information(self, "Busy", "A transcription is running.")
            return
        model = self.model.currentText()
        self.tr_proc = QProcess(self)
        self.tr_proc.setProcessChannelMode(
            QProcess.ProcessChannelMode.MergedChannels)
        self.tr_proc.readyRead.connect(self._read_tr)
        self.tr_proc.finished.connect(self._tr_finished)
        self.tr_btn.setEnabled(False)
        self.status.setText(f"Transcribing with '{model}'... this takes a while.")
        self.tr_proc.start(transcriber(),
                           ["run", str(rec["audio"]), "--model", model,
                            "--you", "You", "--them", "Meeting"])

    def _read_tr(self):
        if not self.tr_proc:
            return
        text = bytes(self.tr_proc.readAll()).decode(errors="replace")
        for line in text.splitlines():
            if line.strip():
                self.status.setText(line.strip())

    def _tr_finished(self, code, _status):
        self.tr_proc = None
        self.tr_btn.setEnabled(True)
        self.status.setText("Transcript ready." if code == 0
                            else "Transcription failed - the audio is still safe.")
        self.reload()
        self.show_selected_transcript()

    # ------------------------------------------------------------- library

    def scan(self):
        """Recordings on disk, newest first."""
        out = []
        if not MEETINGS.is_dir():
            return out
        seen = set()
        for audio in sorted(MEETINGS.glob("*-mic.*"), reverse=True):
            if audio.suffix not in (".wav", ".flac"):
                continue
            stem = audio.name[: -len("-mic" + audio.suffix)]
            if stem in seen:
                continue
            seen.add(stem)
            meta_path = MEETINGS / f"{stem}.json"
            meta = {}
            if meta_path.exists():
                try:
                    meta = json.loads(meta_path.read_text())
                except (OSError, ValueError):
                    meta = {}
            md = MEETINGS / f"{stem}-transcript.md"
            js = MEETINGS / f"{stem}-transcript.json"
            when = datetime.fromtimestamp(audio.stat().st_mtime)
            if meta.get("started"):
                try:
                    when = datetime.fromisoformat(meta["started"])
                except ValueError:
                    pass
            out.append({
                "stem": stem, "audio": audio, "meta": meta,
                "transcript": md if md.exists() else None,
                "segments": js if js.exists() else None,
                "when": when,
                "name": meta.get("name") or stem,
                "seconds": meta.get("duration_seconds"),
            })
        return out

    def reload(self):
        keep = self.current_recording()
        self.all_rows = self.scan()
        self.apply_filter(select=keep["stem"] if keep else None)

    def apply_filter(self, _text=None, select=None):
        """Filter by meeting name or date - 200 recordings is a lot to scroll."""
        needle = self.filter.text().strip().lower() if hasattr(self, "filter") else ""
        if needle:
            self.rows = [r for r in self.all_rows
                         if needle in r["name"].lower()
                         or needle in r["when"].strftime("%b %d %Y %H:%M").lower()]
        else:
            self.rows = list(self.all_rows)
        total = len(self.all_rows)
        shown = len(self.rows)
        self.count_lbl.setText(f"{shown} of {total}" if shown != total
                               else f"{total} recording{'s' if total != 1 else ''}")
        self._fill_table()
        for i, r in enumerate(self.rows):
            if select and r["stem"] == select:
                self.table.selectRow(i)
                self.show_selected_transcript()
                return
        if self.rows:
            self.table.selectRow(0)
        else:
            self.viewer.setHtml("")
            self.viewer_title.setText("TRANSCRIPT")
        # selectRow does not re-emit when the row index is unchanged, so the
        # viewer would keep showing the previously selected recording.
        self.show_selected_transcript()

    def _fill_table(self):
        self.table.setRowCount(len(self.rows))
        for i, r in enumerate(self.rows):
            secs = r["seconds"]
            length = f"{secs // 60}:{secs % 60:02d}" if secs else "-"
            cells = [r["when"].strftime("%b %d  %H:%M"), r["name"], length,
                     "View" if r["transcript"] else "-"]
            for c, text in enumerate(cells):
                item = QTableWidgetItem(text)
                if c == 3:
                    item.setForeground(QColor("#5b9dd9" if r["transcript"]
                                              else "#6b7178"))
                self.table.setItem(i, c, item)
            self.table.setCellWidget(i, 4, self._row_actions(i, r))

    def _row_actions(self, i, rec):
        """Play and Export, on the row itself - the recording is right there."""
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 0, 4, 0)
        h.setSpacing(6)

        play = QPushButton("\u25b6")
        play.setObjectName("row")
        play.setToolTip("Play this recording")
        play.setFixedWidth(34)
        play.clicked.connect(lambda _=False, n=i: self.play_row(n))
        h.addWidget(play)

        pdf = QPushButton("PDF")
        pdf.setObjectName("row")
        pdf.setFixedWidth(42)
        pdf.setEnabled(bool(rec["transcript"]))
        pdf.setToolTip("Export this transcript as a PDF" if rec["transcript"]
                       else "Transcribe it first")
        pdf.clicked.connect(lambda _=False, n=i: self.export_row(n))
        h.addWidget(pdf)
        return box

    def play_row(self, i):
        """Selecting loads the audio; this is the same click without the aim."""
        if self.table.currentRow() != i:
            self.table.selectRow(i)
        self.toggle_play()

    def export_row(self, i):
        if self.table.currentRow() != i:
            self.table.selectRow(i)
        self.export_pdf()

    def current_recording(self):
        rows = self.table.selectionModel().selectedRows()
        if not rows:
            return None
        idx = rows[0].row()
        return self.rows[idx] if 0 <= idx < len(self.rows) else None

    def show_selected_transcript(self):
        rec = self.current_recording()
        if not rec:
            return
        path = self.track_path(rec)
        if path:
            self.player.stop()
            self.player.setSource(QUrl.fromLocalFile(str(path)))
        self.viewer_title.setText(f"TRANSCRIPT · {rec['name'].upper()}")
        self.marks = []
        self.mark_at = -1
        self.viewer.setExtraSelections([])
        if not rec["transcript"]:
            self.viewer.setMarkdown(
                f"### {rec['name']}\n\nNo transcript yet.\n\n"
                "Choose a model on the left and press **Transcribe**.")
            self.pdf_btn.setEnabled(False)
            return
        self.pdf_btn.setEnabled(True)

        # The JSON is the same transcript with its timings intact; the markdown
        # is what survives when only it is present. Prefer the JSON so playback
        # can follow along, and fall back rather than showing nothing.
        segs = self.load_segments(rec)
        if segs:
            self.marks = fill_transcript(
                self.viewer.document(), segs, rec["name"],
                rec["when"].strftime("%Y-%m-%d %H:%M"))
            self.viewer.moveCursor(QTextCursor.MoveOperation.Start)
            return
        try:
            self.viewer.setHtml(transcript_html(rec["transcript"].read_text()))
        except OSError as e:
            self.viewer.setPlainText(f"Could not read transcript: {e}")

    @staticmethod
    def load_segments(rec):
        """Timed segments for a recording, or [] if there are none to have."""
        if not rec or not rec.get("segments"):
            return []
        try:
            return json.loads(rec["segments"].read_text()).get("segments") or []
        except (OSError, ValueError):
            return []

    # -------------------------------------------------------------- follow

    def _follow(self, pos):
        """Highlight whatever is being said at `pos`, and keep it on screen."""
        if not self.marks:
            return
        lo, hi, found = 0, len(self.marks) - 1, -1
        while lo <= hi:                      # the last mark that has started
            mid = (lo + hi) // 2
            if self.marks[mid][0] <= pos:
                found, lo = mid, mid + 1
            else:
                hi = mid - 1
        if found >= 0 and pos > self.marks[found][1] + 400:
            found = -1                       # a gap - silence, or the other track
        if found == self.mark_at:
            return
        self.mark_at = found
        if found < 0:
            self.viewer.setExtraSelections([])
            return

        _, _, cstart, cend = self.marks[found]
        sel = QTextEdit.ExtraSelection()
        sel.cursor = QTextCursor(self.viewer.document())
        sel.cursor.setPosition(cstart)
        sel.cursor.setPosition(cend, QTextCursor.MoveMode.KeepAnchor)
        sel.format.setBackground(QColor("#3d5a80"))
        sel.format.setForeground(QColor("#ffffff"))
        self.viewer.setExtraSelections([sel])

        # Scroll only when the highlight would otherwise be off screen, so
        # reading ahead of the audio still works.
        rect = self.viewer.cursorRect(sel.cursor)
        if rect.top() < 0 or rect.bottom() > self.viewer.viewport().height():
            bar = self.viewer.verticalScrollBar()
            bar.setValue(bar.value() + rect.top()
                         - self.viewer.viewport().height() // 3)

    # ----------------------------------------------------------------- pdf

    def export_pdf(self):
        rec = self.current_recording()
        if not rec or not rec["transcript"]:
            return
        default = str(Path.home() / f"{rec['stem']}-transcript.pdf")
        out, _ = QFileDialog.getSaveFileName(
            self, "Export transcript as PDF", default, "PDF (*.pdf)")
        if not out:
            return
        if not out.lower().endswith(".pdf"):
            out += ".pdf"

        doc = QTextDocument()
        segs = self.load_segments(rec)
        when = rec["when"].strftime("%A %d %B %Y, %H:%M")
        if segs:
            fill_transcript(doc, segs, rec["name"], when, printing=True)
        else:
            try:
                doc.setPlainText(rec["transcript"].read_text())
            except OSError as e:
                QMessageBox.warning(self, "meetcap", f"Could not read it: {e}")
                return

        printer = QPrinter(QPrinter.PrinterMode.HighResolution)
        printer.setOutputFormat(QPrinter.OutputFormat.PdfFormat)
        printer.setOutputFileName(out)
        # Wrap to the page rather than to whatever width the pane happens to be.
        doc.setPageSize(printer.pageRect(QPrinter.Unit.Point).size())
        doc.print(printer)
        self.status.setText(f"Saved {Path(out).name}")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("meetcap")
    app.setStyleSheet(CSS.replace("__ARROW__", arrow_icon()))
    if mc is None:
        QMessageBox.critical(None, "meetcap",
                             f"Could not load the meetcap CLI:\n{_load_error}")
        return 1
    win = MeetcapWindow()
    if os.environ.get("MEETCAP_SHOT"):     # headless render for testing
        win.show()
        QTimer.singleShot(700, lambda: (
            win.grab().save(os.environ["MEETCAP_SHOT"]), app.quit()))
        return app.exec()
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
